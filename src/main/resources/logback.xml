<?xml version="1.0" encoding="utf-8"?>
<configuration scan="false">
    <contextName>excel2word</contextName>

    <conversionRule conversionWord="shortPkg" converterClass="com.xant.component.SimplifiedPackageConverter"/>

    <property name="LOG.PATTERN" value="%d{HH:mm:ss.SSS} [%thread] %-5level %shortPkg - %msg%n"/>
    <property name="LOG.ENCODING" value="${log.encoding:-UTF-8}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG.PATTERN}</pattern>
            <charset>${LOG.ENCODING}</charset>
        </encoder>
    </appender>

    <!-- 2. 自定义 TextArea 输出 -->
    <appender name="TEXT_AREA" class="com.xant.component.TextAreaAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{HH:mm:ss} %-5level - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="com.xant" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="TEXT_AREA"/>
    </logger>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="TEXT_AREA"/>
    </root>

</configuration>
